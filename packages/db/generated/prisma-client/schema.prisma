datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DROPDOWN
  DATE
}

enum CustomFieldParentType {
  CONTACT
  DEAL
}

enum CustomFieldValueSource {
  MANUAL
  WORKFLOW
  CALL
  SMS
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum CommType {
  CALL
  SMS
  WHATSAPP
  EMAIL
}

enum CommStatus {
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  FAILED
  VOICEMAIL
  BUSY
  SENT
  DELIVERED
  RECEIVED
  READ
}

enum ExtractionStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

enum Plan {
  FREE
  GROWTH
  PRO
}

enum TeamSize {
  SOLO
  SMALL
  MEDIUM
  LARGE
}

enum ActivityType {
  CALL_INBOUND
  CALL_OUTBOUND
  SMS_SENT
  SMS_RECEIVED
  WHATSAPP_SENT
  WHATSAPP_RECEIVED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  BOOKING_CREATED
  FIELD_UPDATED
  WORKFLOW_TRIGGERED
  NOTE_ADDED
  CONTACT_CREATED
}

// ─────────────────────────────────────────────
// TENANT — with onboarding fields
// ─────────────────────────────────────────────

model Tenant {
  id             String    @id @default(uuid())
  name           String // business name
  slug           String    @unique
  plan           Plan      @default(FREE)
  timezone       String    @default("Asia/Kolkata")
  businessType   String? // retail | real estate | garage | ecommerce
  websiteUrl     String? // auto-scraped for first agent KB
  teamSize       TeamSize?
  monthlyRevenue String? // optional range: "0-1L" | "1-10L" | "10L+"
  onboardingStep Int       @default(0)
  onboardingDone Boolean   @default(false)
  // Cached credit balance — the CreditLedger is the source of truth; this
  // is kept in sync inside the same transaction as every ledger write.
  creditBalance  Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  users               User[]
  contacts            Contact[]
  customFieldDefs     CustomFieldDefinition[]
  deals               Deal[]
  pipelines           Pipeline[]
  pipelineStages      PipelineStage[]
  dealStageHistory    DealStageHistory[]
  workflows           WorkflowDefinition[]
  workflowFolders     WorkflowFolder[]
  workflowRuns        WorkflowRun[]
  aiAgents            AIAgent[]
  phoneNumbers        PhoneNumber[]
  communicationLogs   CommunicationLog[]
  chatSessions        ChatSession[]
  activities          Activity[]
  notes               Note[]
  bookings            Booking[]
  knowledgeBase       KnowledgeBase[]
  creditLedger        CreditLedger[]
  billingSubscription BillingSubscription?
  paymentRecords      PaymentRecord[]

  @@map("tenants")
}

// ─────────────────────────────────────────────
// BILLING — credits ledger + provider subscription
// ─────────────────────────────────────────────

enum CreditReason {
  SIGNUP_GRANT
  PLAN_GRANT
  TOPUP_PURCHASE
  CALL_DEDUCTION
  ADJUSTMENT
}

// Auditable, append-only record of every credit movement. Positive delta =
// grant, negative = deduction. Tenant.creditBalance is the cached sum.
model CreditLedger {
  id        String       @id @default(uuid())
  tenantId  String
  delta     Int
  reason    CreditReason
  refId     String? // e.g. CommunicationLog id for call deductions
  note      String?
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("credit_ledger")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

// Every successful payment — the audit trail behind invoices. Amounts are
// stored in paise (Razorpay's unit) to avoid float rounding.
model PaymentRecord {
  id          String   @id @default(uuid())
  tenantId    String
  provider    String   @default("razorpay")
  paymentId   String   @unique
  orderId     String
  product     String // "pro-30d" | "credits"
  amountPaise Int
  currency    String   @default("INR")
  status      String   @default("captured")
  description String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("payment_records")
}

model BillingSubscription {
  id               String             @id @default(uuid())
  tenantId         String             @unique
  provider         String             @default("razorpay")
  providerSubId    String?
  plan             Plan
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("billing_subscriptions")
}

// ─────────────────────────────────────────────
// USER — team members
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  deals    Deal[]
  bookings Booking[]

  @@unique([tenantId, email])
  @@map("users")
}

// ─────────────────────────────────────────────
// CONTACT — center of CRM
// ─────────────────────────────────────────────

model Contact {
  id        String    @id @default(uuid())
  tenantId  String
  firstName String
  lastName  String
  emails    String[]
  phones    String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  customFields      CustomFieldValue[]
  deals             Deal[]
  bookings          Booking[]
  notes             Note[]
  activities        Activity[]
  communicationLogs CommunicationLog[]
  chatSessions      ChatSession[]

  @@map("contacts")
}

// ─────────────────────────────────────────────
// CUSTOM FIELD DEF — typed field declarations
// ─────────────────────────────────────────────

model CustomFieldDefinition {
  id         String                @id @default(uuid())
  tenantId   String
  name       String
  type       CustomFieldType
  parentType CustomFieldParentType
  options    String[]              @default([])
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  values CustomFieldValue[]

  @@map("custom_field_defs")
}

// ─────────────────────────────────────────────
// CUSTOM FIELD VALUE — typed values per contact
// ─────────────────────────────────────────────

model CustomFieldValue {
  id                String                 @id @default(uuid())
  tenantId          String
  contactId         String
  fieldDefinitionId String
  textValue         String?
  numberValue       Float?
  booleanValue      Boolean?
  dateValue         DateTime?
  source            CustomFieldValueSource
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  contact         Contact               @relation(fields: [contactId], references: [id])
  fieldDefinition CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id])

  @@map("custom_field_values")
}

// ─────────────────────────────────────────────
// DEAL — sales pipeline
// ─────────────────────────────────────────────

enum DealProbabilitySource {
  AUTO
  MANUAL
}

enum DealPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DealHealth {
  HEALTHY
  NEEDS_ATTENTION
  HIGH_RISK
}

model Deal {
  id         String  @id @default(uuid())
  tenantId   String
  contactId  String
  pipelineId String?
  stageId    String?
  title      String
  // `stage` holds the stage NAME and is kept in sync with `stageId`. Legacy
  // consumers (Kanban board) read the name; new logic uses the relation.
  stage      String

  // ── Financial ──
  value             Float                 @default(0)
  currency          String                @default("INR")
  probability       Int                   @default(10)
  probabilitySource DealProbabilitySource @default(AUTO)
  weightedValue     Float                 @default(0)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?

  // ── Status ──
  priority       DealPriority @default(MEDIUM)
  leadSource     String?
  tags           String[]     @default([])
  ownerId        String?
  lastActivityAt DateTime?
  nextFollowUpAt DateTime?

  // ── AI ──
  aiSummary        String?
  aiHealth         DealHealth?
  aiRiskScore      Int?
  aiNextAction     String?
  aiConfidence     Float?
  lastAiAnalysisAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  contact       Contact            @relation(fields: [contactId], references: [id])
  pipeline      Pipeline?          @relation(fields: [pipelineId], references: [id])
  pipelineStage PipelineStage?     @relation(fields: [stageId], references: [id])
  owner         User?              @relation(fields: [ownerId], references: [id])
  activities    Activity[]
  stageHistory  DealStageHistory[]

  @@index([tenantId, pipelineId, stage])
  @@index([tenantId, nextFollowUpAt])
  @@map("deals")
}

model Pipeline {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  // Legacy mirror of ordered stage names — kept in sync with `stageConfigs`
  // so existing consumers keep working while they migrate to the relation.
  stages    String[]
  filters   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  deals        Deal[]
  stageConfigs PipelineStage[]

  @@map("pipelines")
}

model PipelineStage {
  id          String    @id @default(uuid())
  tenantId    String
  pipelineId  String
  name        String
  color       String    @default("#6366f1")
  position    Int
  probability Int       @default(10)
  isWon       Boolean   @default(false)
  isLost      Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

// Immutable record of every stage transition — powers stage history,
// duration-in-stage metrics, and sales-cycle analytics.
model DealStageHistory {
  id          String   @id @default(uuid())
  tenantId    String
  dealId      String
  fromStage   String?
  toStage     String
  changedById String?
  comment     String?
  changedAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, changedAt])
  @@map("deal_stage_history")
}

// ─────────────────────────────────────────────
// BOOKING — appointments
// ─────────────────────────────────────────────

model Booking {
  id         String   @id @default(uuid())
  tenantId   String
  contactId  String
  title      String
  startTime  DateTime
  endTime    DateTime
  status     String
  agentId    String?
  assigneeId String?
  ccEmails   String[] @default([])
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  contact    Contact    @relation(fields: [contactId], references: [id])
  agent      AIAgent?   @relation(fields: [agentId], references: [id])
  assignee   User?      @relation(fields: [assigneeId], references: [id])
  activities Activity[]

  @@map("bookings")
}

// ─────────────────────────────────────────────
// NOTE — manual notes
// ─────────────────────────────────────────────

model Note {
  id        String   @id @default(uuid())
  tenantId  String
  contactId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  contact    Contact    @relation(fields: [contactId], references: [id])
  activities Activity[]

  @@map("notes")
}

// ─────────────────────────────────────────────
// WORKFLOW DEF — agent-owned workflows
// ─────────────────────────────────────────────

model WorkflowDefinition {
  id          String   @id @default(uuid())
  tenantId    String
  folderId    String?
  name        String
  triggerType String
  actions     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  folder WorkflowFolder? @relation(fields: [folderId], references: [id])
  runs   WorkflowRun[]

  @@index([tenantId, folderId])
  @@map("workflow_definitions")
}

// ─────────────────────────────────────────────
// WORKFLOW FOLDER — nested organisation for workflows
// ─────────────────────────────────────────────

model WorkflowFolder {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  parent    WorkflowFolder?      @relation("FolderTree", fields: [parentId], references: [id])
  children  WorkflowFolder[]     @relation("FolderTree")
  workflows WorkflowDefinition[]

  @@index([tenantId, parentId])
  @@map("workflow_folders")
}

// ─────────────────────────────────────────────
// WORKFLOW RUN — execution logs
// ─────────────────────────────────────────────

model WorkflowRun {
  id                   String    @id @default(uuid())
  tenantId             String
  workflowDefinitionId String
  status               String
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  definition        WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  activities        Activity[]
  communicationLogs CommunicationLog[]

  @@map("workflow_runs")
}

// ─────────────────────────────────────────────
// AI AGENT — agent with full persona + settings
// ─────────────────────────────────────────────

model AIAgent {
  id                         String    @id @default(uuid())
  tenantId                   String
  name                       String
  role                       String    @default("Support")
  language                   String    @default("Hinglish")
  greetingMessage            String    @default("Namaste! Main aapki kaise help kar sakti hoon?")
  tone                       String    @default("Friendly")
  fallbackMessage            String    @default("I'll connect you with our team for this. One moment please.")
  businessInfo               String?
  websiteUrl                 String?
  maxDuration                Int       @default(10)
  dndCompliance              Boolean   @default(true)
  recordingConsent           Boolean   @default(true)
  isActive                   Boolean   @default(true)
  // How the agent should talk and behave — written by the business owner in
  // the dashboard, injected into the live call prompt as its own section.
  agentGuidelines            String?
  modelName                  String
  voice                      String    @default("sarvam:priya")
  // Speaking-speed multiplier. Null = per-provider default (providers pace
  // the same nominal speed very differently, so a single global constant
  // made Sarvam drag and ElevenLabs rush).
  voiceSpeed                 Float?
  // Per-voice provider tunables chosen by the user in the dashboard
  // (ElevenLabs: stability/similarityBoost/style; Sarvam: temperature).
  // Null = provider defaults.
  voiceSettings              Json?
  // User-defined word → spoken-form overrides ({"NAIC": "N A I C"}).
  // Source of truth for the synced Sarvam pronunciation dictionary.
  pronunciations             Json?
  // Sarvam pronunciation dictionary id (p_xxx) synced from `pronunciations`.
  pronunciationDictId        String?
  intakeWorkflowId           String?
  smsWorkflowId              String?
  phoneNumberId              String?
  intakeEnabled              Boolean   @default(false)
  intakeFields               String[]  @default([])
  intakePrompt               String?
  smsEnabled                 Boolean   @default(false)
  smsTriggerCondition        String?
  smsTemplate                String?
  smsAgentReply              String?
  whatsappEnabled            Boolean   @default(false)
  whatsappPrompt             String?
  apiEnabled                 Boolean   @default(false)
  apiWorkflowId              String?
  apiPrompt                  String?
  callTransferEnabled        Boolean   @default(false)
  callTransferWorkflowId     String?
  callTransferNumber         String?
  callTransferCondition      String?
  callTransferMessage        String?
  callTransferFallbackNumber String?
  callTransferTimeoutSec     Int       @default(25)
  callTransferNoAnswerAction String    @default("take_message")
  callTransferStyle          String    @default("warm")
  bookingEnabled             Boolean   @default(false)
  bookingConfig              Json?
  businessHours              Json?
  timeZone                   String    @default("Asia/Kolkata")
  deletedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  communicationLogs CommunicationLog[]
  knowledgeBases    KnowledgeBase[]
  chatSessions      ChatSession[]
  bookings          Booking[]

  @@map("ai_agents")
}

// ─────────────────────────────────────────────
// PHONE NUMBER — assigned numbers
// ─────────────────────────────────────────────

enum PhoneNumberKind {
  // The owner's own contact number captured at signup — NEVER assignable
  // to an agent; it's where the business is reached, not an AI line.
  BUSINESS
  // A real telephony line (purchased via Twilio) that an agent answers.
  AGENT_LINE
}

model PhoneNumber {
  id          String          @id @default(uuid())
  tenantId    String
  phoneNumber String          @unique
  label       String?
  kind        PhoneNumberKind @default(AGENT_LINE)
  // Twilio resource sid for purchased numbers — needed to configure or
  // release the number later. Null for manually-added legacy numbers.
  twilioSid   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("phone_numbers")
}

// ─────────────────────────────────────────────
// KNOWLEDGE BASE — per-agent knowledge
// ─────────────────────────────────────────────

model KnowledgeBase {
  id        String   @id @default(uuid())
  tenantId  String
  agentId   String
  name      String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  agent  AIAgent @relation(fields: [agentId], references: [id])

  @@map("knowledge_bases")
}

// ─────────────────────────────────────────────
// SINGLE TABLE FOR ALL COMMUNICATION LOGS
// Replaces: CallLog, SmsLog, WhatsappLog
// ─────────────────────────────────────────────

model CommunicationLog {
  id               String           @id @default(uuid())
  tenantId         String
  contactId        String
  agentId          String
  workflowRunId    String?
  phoneNumberId    String?
  type             CommType
  direction        Direction
  status           CommStatus
  duration         Int?
  recordingUrl     String?
  transcript       String?
  transcriptJson   Json?
  sentimentScore   Float?
  extractionStatus ExtractionStatus @default(PENDING)
  extractedFields  Json?
  body             String?
  mediaUrl         String?
  subject          String?
  deliveredAt      DateTime?
  provider         String?
  providerRef      String?
  metadata         Json?
  sessionId        String?
  occurredAt       DateTime
  createdAt        DateTime         @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  contact     Contact      @relation(fields: [contactId], references: [id])
  agent       AIAgent      @relation(fields: [agentId], references: [id])
  workflowRun WorkflowRun? @relation(fields: [workflowRunId], references: [id])
  session     ChatSession? @relation(fields: [sessionId], references: [id])
  activities  Activity[]

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([contactId, occurredAt(sort: Desc)])
  @@index([agentId, occurredAt(sort: Desc)])
  @@index([tenantId, type, occurredAt(sort: Desc)])
  @@index([tenantId, agentId, type])
  @@index([sessionId])
  @@map("communication_logs")
}

// ─────────────────────────────────────────────
// CHAT SESSION — groups chat messages into a conversation window so
// post-processing (intent, deals, scoring) can run when the chat goes idle.
// ─────────────────────────────────────────────

enum ChatSessionStatus {
  OPEN
  PROCESSED
}

model ChatSession {
  id            String            @id @default(uuid())
  tenantId      String
  contactId     String
  agentId       String
  channel       CommType          @default(WHATSAPP)
  status        ChatSessionStatus @default(OPEN)
  // One conversation = one CommunicationLog; turns live in its transcriptJson.
  commLogId     String?           @unique
  // When a human replies from the dashboard, the AI stops auto-replying.
  humanTakeover Boolean           @default(false)
  startedAt     DateTime          @default(now())
  lastMessageAt DateTime          @default(now())
  processedAt   DateTime?
  dealId        String?
  createdAt     DateTime          @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  contact  Contact            @relation(fields: [contactId], references: [id])
  agent    AIAgent            @relation(fields: [agentId], references: [id])
  messages CommunicationLog[]

  @@index([status, lastMessageAt])
  @@index([tenantId, contactId, agentId, status])
  @@map("chat_sessions")
}

// ─────────────────────────────────────────────
// ACTIVITY — updated to reference CommunicationLog
// ─────────────────────────────────────────────

model Activity {
  id            String       @id @default(uuid())
  tenantId      String
  contactId     String
  type          ActivityType
  direction     Direction?
  summary       String
  metadata      Json?
  commLogId     String?
  dealId        String?
  bookingId     String?
  workflowRunId String?
  noteId        String?
  occurredAt    DateTime
  createdAt     DateTime     @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  contact     Contact           @relation(fields: [contactId], references: [id])
  commLog     CommunicationLog? @relation(fields: [commLogId], references: [id])
  deal        Deal?             @relation(fields: [dealId], references: [id])
  booking     Booking?          @relation(fields: [bookingId], references: [id])
  workflowRun WorkflowRun?      @relation(fields: [workflowRunId], references: [id])
  note        Note?             @relation(fields: [noteId], references: [id])

  @@index([contactId, occurredAt(sort: Desc)])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, type])
  @@map("activities")
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_otps")
}

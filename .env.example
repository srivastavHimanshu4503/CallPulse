# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:localpass@localhost:5432/indiai
POSTGRES_PASSWORD=localpass

# Auth
JWT_SECRET=local-dev-jwt-secret-min-32-characters
JWT_REFRESH_SECRET=local-dev-refresh-secret-min-32-characters

# Typesense
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=local-dev-key

# Telephony (get from Exotel after signup)
EXOTEL_API_KEY=CHANGE_ME
EXOTEL_API_TOKEN=CHANGE_ME
EXOTEL_ACCOUNT_SID=CHANGE_ME

# AI
AI_API_KEY=CHANGE_ME

# AWS (only needed on server — not locally)
AWS_REGION=ap-south-1
CALL_PROCESSING_QUEUE_URL=
WORKFLOW_JOBS_QUEUE_URL=
TYPESENSE_SYNC_QUEUE_URL=

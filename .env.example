# ==============================================================================
# Antigravity / DeskBuddy Environment Configuration (.env.example)
# Copy this file to .env before starting the development environment:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:localpass@localhost:5432/indiai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localpass
POSTGRES_DB=indiai

# ------------------------------------------------------------------------------
# Auth & JWT Secrets (Replace with secure random strings)
# ------------------------------------------------------------------------------
JWT_SECRET=local-dev-jwt-secret-min-32-characters-change-in-production
JWT_REFRESH_SECRET=local-dev-refresh-secret-min-32-characters-change-in-production
CALENDAR_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Typesense Search Engine
# ------------------------------------------------------------------------------
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=local-dev-key

# ------------------------------------------------------------------------------
# Microservice Internal Communication
# ------------------------------------------------------------------------------
POST_CALL_SERVER_URL=http://localhost:3002
POST_CALL_SERVER_SECRET=local-dev-post-call-secret-12345

# ------------------------------------------------------------------------------
# LiveKit WebRTC & Voice Server
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://placeholder-project.livekit.cloud
LIVEKIT_API_KEY=API_placeholder_livekit_key
LIVEKIT_API_SECRET=secret_placeholder_livekit_secret
LIVEKIT_AGENT_NAME=inbound-agent-local

# ------------------------------------------------------------------------------
# Telephony & Messaging: Twilio
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_placeholder_twilio_account_sid
TWILIO_AUTH_TOKEN=placeholder_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WABA_ID=
WHATSAPP_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Telephony: Plivo (India Numbers & SIP Trunking)
# ------------------------------------------------------------------------------
PLIVO_AUTH_ID=placeholder_plivo_auth_id
PLIVO_AUTH_TOKEN=placeholder_plivo_auth_token
PLIVO_COMPLIANCE_APPLICATION_ID=
PLIVO_TRUNK_ID=

# ------------------------------------------------------------------------------
# Payments: Razorpay (Test Mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# ------------------------------------------------------------------------------
# AI & LLM Providers
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-placeholder-openai-api-key
GEMINI_API_KEY=AIzaSyPlaceholderGeminiApiKey
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-api-key

# ------------------------------------------------------------------------------
# Speech-To-Text (STT) & Text-To-Speech (TTS)
# ------------------------------------------------------------------------------
STT_PROVIDER=sarvam
SARVAM_API_KEY=sarvam_placeholder_api_key
DEEPGRAM_API_KEY=deepgram_placeholder_api_key
SONIOX_API_KEY=soniox_placeholder_api_key
ELEVENLABS_API_KEY=elevenlabs_placeholder_api_key
CARTESIA_API_KEY=cartesia_placeholder_api_key

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
ENABLE_OUTBOUND=false
ENABLE_WHATSAPP=false
ENABLE_POST_CALL_TEMPORAL=false
ENABLE_MULTI_TENANT=false

# ------------------------------------------------------------------------------
# AWS (Production / Optional in Local Dev)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_REGION=ap-south-1
RECORDINGS_S3_ACCESS_KEY=
RECORDINGS_S3_SECRET=
CALL_PROCESSING_QUEUE_URL=
WORKFLOW_JOBS_QUEUE_URL=
TYPESENSE_SYNC_QUEUE_URL=

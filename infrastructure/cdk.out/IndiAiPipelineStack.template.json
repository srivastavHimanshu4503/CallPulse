    "Source": {
     "BuildSpec": "{\n  \"version\": \"0.2\",\n  \"phases\": {\n    \"build\": {\n      \"commands\": [\n        \"INSTANCE_ID=$(aws ssm get-parameter --name /indiai/ec2-instance-id --region us-east-1 --query Parameter.Value --output text)\",\n        \"COMMAND_ID=$(aws ssm send-command --region ap-south-1 --instance-ids $INSTANCE_ID --document-name AWS-RunShellScript --parameters commands=[\\\"export HOME=/root\\\",\\\"git config --global --add safe.directory /app/indiAi\\\",\\\"git -C /app/indiAi pull origin main\\\",\\\"chown -R ec2-user:ec2-user /app/indiAi\\\",\\\"cd /app/indiAi && docker compose down\\\",\\\"cd /app/indiAi && docker compose build --no-cache\\\",\\\"cd /app/indiAi && docker compose up -d\\\",\\\"sleep 15\\\",\\\"curl -f http://localhost:3000/api/v1/health && echo Health-check-passed || echo Health-check-failed\\\"] --query Command.CommandId --output text)\",\n        \"aws ssm wait command-executed --command-id $COMMAND_ID --instance-id $INSTANCE_ID --region ap-south-1\",\n        \"aws ssm get-command-invocation --command-id $COMMAND_ID --instance-id $INSTANCE_ID --region ap-south-1\"\n      ]\n    }\n  }\n}",
     "Type": "CODEPIPELINE"
    }
   },
